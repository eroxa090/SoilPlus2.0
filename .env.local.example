# --- Copy to .env.local and fill in real values (never commit .env.local) ---

# Supabase — production database for users + orders.
# Your project: SoilPlus2.0
SUPABASE_URL=https://wpetubtrcurxbdtqudyh.supabase.co
# Service-role key (Project -> Settings -> API -> "service_role" secret).
# NEVER expose this to the browser. Only used in server-side API routes.
SUPABASE_SERVICE_ROLE_KEY=paste_service_role_key_here

# Google Gemini — /api/chat, /api/diagnose, /api/forecast.
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=paste_gemini_key_here

# OpenWeatherMap — /api/weather. https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=paste_openweathermap_key_here

# 32-byte random HMAC secret for session cookies.
# Generate with:  openssl rand -hex 32
SESSION_SECRET=replace_with_32_random_bytes

# Password-reset email (/forgot-password). Gmail works: turn on 2-step
# verification, then create an "app password" at myaccount.google.com/apppasswords
# and paste the 16 letters below — NOT your normal Gmail password.
# Without these, production shows "recovery is not configured"; in dev the
# reset link is printed to the terminal instead of being emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=paste_16_letter_app_password
# Optional: sender name/address and the site URL used in reset links.
# MAIL_FROM=SoilPlus <your-address@gmail.com>
# APP_URL=https://soil-plus20.vercel.app
